# ============================================================
# Soko Beauty — .env.local (NO COMMITEAR)
# --------------------------------------------------------
# Crea este archivo como `.env.local` en la raíz del proyecto
# y rellena los valores con los de tu proyecto Supabase.
#
# Para generar uno nuevo: cp .env.local.template .env.local
# ============================================================

# ─── Supabase (público — seguro de exponer al browser) ───────────
# Los sacas de: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...TU_ANON_KEY

# ─── Supabase (server-only — NUNCA exponer al browser) ──────────
# Misma pantalla, sección "service_role" (secret). La usa el
# mini-panel admin para escribir productos/editar tasas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...TU_SERVICE_ROLE_KEY

# ─── Sitio ──────────────────────────────────────────────────────
# Número de WhatsApp que recibe los pedidos (ya lo tienes)
NEXT_PUBLIC_WHATSAPP_NUMBER=584244273062
# URL pública del sitio (en dev: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://sokobeauty.ve

# ─── Tasas de cambio (DolarVZLA — provider por defecto) ─────────
# Déjalos vacíos para usar los defaults. Rellénalos solo si
# DolarVZLA cambia sus endpoints.
RATES_BCV_URL=
RATES_USDT_URL=
# Solo necesaria para el endpoint USDT/Binance. Bcvla sin key.
# Regístrate gratis en https://dolarvzla.com para obtenerla.
DOLARVZLA_API_KEY=

# ─── Provider alternativo: Arepa Tecnológica ───────────────────
# Déjalo vacío hasta que el dueño confirme el endpoint/formato.
RATES_API_URL=

# ─── Admin ──────────────────────────────────────────────────────
# Contraseña compartida para el mini-panel. Antes de producción
# real, migrar a Supabase Auth (usuarios con magic link).
ADMIN_PASSWORD=cambia-esta-clave
