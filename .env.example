# ============================================================
# Soko Beauty — Environment variables
# Copy to .env.local and fill in real values for local dev.
# ============================================================

# --- Supabase (public — safe to ship to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — never expose) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_WHATSAPP_NUMBER=584244273062
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Exchange-rate provider (DolarVZLA is the default) ---
# Override only if DolarVZLA changes its endpoints.
RATES_BCV_URL=
RATES_USDT_URL=
DOLARVZLA_API_KEY=

# --- Optional alternative provider (Arepa Tecnológica) ---
# Owner hasn't confirmed the endpoint yet — leave blank for now.
RATES_API_URL=

# --- Admin panel ---
# Simple shared password for the MVP admin. Replace with Supabase Auth
# before opening this to the public.
ADMIN_PASSWORD=
